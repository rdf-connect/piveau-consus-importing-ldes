@prefix rdfl: <https://w3id.org/rdf-lens/ontology#>.
@prefix rdfc: <https://w3id.org/rdf-connect#>.
@prefix rml: <http://w3id.org/rml/>.
@prefix js: <https://w3id.org/conn/js#>.
@prefix ws: <https://w3id.org/conn/ws#>.
@prefix : <https://w3id.org/conn#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix rml: <https://w3id.org/conn/rml#>.
@prefix ql: <http://semweb.mmlab.be/ns/ql#>.

<> owl:imports <./node_modules/@rdfc/js-runner/index.ttl>.
<> owl:imports <./processor.ttl>.
<> a rdfc:Pipeline;
  rdfc:consistsOf [
    rdfc:instantiates rdfc:NodeRunner;
    rdfc:processor <httpInput>, <piveau>;
  ].

<data> a rdfc:Reader, rdfc:Writer.
<transformed> a rdfc:Reader, rdfc:Writer.
<httpInput> a rdfc:HTTPConsumer;
  rdfc:output <data>;
  rdfc:port [
    a rdfl:EnvVariable;
    rdfl:envDefault 3000;
    rdfl:envKey "LDES_PORT";
  ];
  rdfc:host "0.0.0.0";
  rdfc:statusCode 202.

<piveau> a rdfc:Piveau;
  rdfc:input <data>.

